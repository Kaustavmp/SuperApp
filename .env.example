# ============================================================
# SuperApp — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# LLM Provider Selection
# Options: "ollama" | "anthropic" | "openai"
# ------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Ollama (local, default for development) ---
OLLAMA_HOST=http://localhost:11434
# Fast/cheap tier (claim extraction, candidate pruning)
OLLAMA_FAST_MODEL=llama3.1
# Mid tier (coverage diff, contradiction classification)
OLLAMA_MID_MODEL=llama3.1
# Top tier (schema induction — used rarely)
OLLAMA_TOP_MODEL=llama3.1
# Embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Anthropic Claude (production recommended) ---
ANTHROPIC_API_KEY=
# Fast/cheap tier
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Mid tier
ANTHROPIC_MID_MODEL=claude-sonnet-4-5
# Top tier
ANTHROPIC_TOP_MODEL=claude-opus-4-5

# --- OpenAI (alternative) ---
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_MID_MODEL=gpt-4o
OPENAI_TOP_MODEL=gpt-4o

# ------------------------------------------------------------
# Model Cascade Step → Tier Mappings
# Values: "fast" | "mid" | "top"
# ------------------------------------------------------------
CASCADE_CLAIM_EXTRACTION=fast
CASCADE_COVERAGE_DIFF=mid
CASCADE_CONTRADICTION_CLASSIFICATION=mid
CASCADE_SCHEMA_INDUCTION=top

# ------------------------------------------------------------
# Chunking
# ------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------
# Confidence Thresholds
# ------------------------------------------------------------
MIN_CONFIDENCE_THRESHOLD=0.3
CONTRADICTION_SIMILARITY_THRESHOLD=0.5

# ------------------------------------------------------------
# Vector Store (ChromaDB — pgvector planned for Phase 2)
# ------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db

# ------------------------------------------------------------
# Database (SQLite MVP — Postgres planned for Phase 2)
# Options: "sqlite" | "postgres"
# ------------------------------------------------------------
DB_BACKEND=sqlite
SQLITE_PATH=./superapp.db
DATABASE_URL=sqlite:///./superapp.db
# POSTGRES_URL=postgresql://user:password@localhost:5432/superapp

# ------------------------------------------------------------
# Cost Controls
# ------------------------------------------------------------
# Max tokens per single analysis job (0 = unlimited)
MAX_TOKENS_PER_JOB=500000
# Max LLM cost per job in USD (0 = unlimited)
MAX_COST_PER_JOB_USD=0

# ------------------------------------------------------------
# Platform (Phase 2 — leave empty for now)
# ------------------------------------------------------------
AUTH_PROVIDER=none
# AUTH_PROVIDER=clerk
# CLERK_SECRET_KEY=

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
